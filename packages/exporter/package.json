{
  "name": "@vicolobuilder/exporter",
  "version": "0.1.0",
  "description": "Exporter — traduzione di Document/IR in HTML/CSS statico pubblicabile (consumer 4 dell'Engine).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicolobuilder/engine": "^0.1.0",
    "@vicolobuilder/render-conventions": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
